{
	"name": "vfg-vue3",
	"version": "1.2.0",
	"description": "Forked of vfg-next with some fixes and upgrades. A schema-based form generator component for Vue.js 3",
	"homepage": "https://github.com/primaftr/vfg-vue3/",
	"private": false,
	"main": "dist/vfg-vue3.umd.js",
	"module": "dist/vfg-vue3.esm.js",
	"exports": {
		"import": "./dist/vfg-vue3.esm.js",
		"require": "./dist/vfg-vue3.umd.js"
	},
	"jsnext:main": "dist/vfg-vue3.esm.js",
	"unpkg": "dist/vfg-vue3.umd.js",
	"jsdelivr": "dist/vfg-vue3.umd.js",
	"style": "dist/vfg-vue3.css",
	"files": [
		"src",
		"dist"
	],
	"author": "Icebob",
	"license": "MIT",
	"scripts": {
		"build": "npx rimraf dist && vite build",
		"dev": "npx rimraf dist && vite",
		"lint": "vue-cli-service lint"
	},
	"keywords": [
		"vue",
		"vue3",
		"vuejs",
		"form",
		"generator",
		"schema",
		"json"
	],
	"devDependencies": {
		"@atomico/rollup-plugin-sizes": "^1.1.4",
		"@babel/core": "^7.11.6",
		"@babel/preset-env": "^7.11.5",
		"@betit/rollup-plugin-rename-extensions": "^0.1.0",
		"@rollup/plugin-alias": "^3.1.2",
		"@rollup/plugin-babel": "^5.2.2",
		"@rollup/plugin-commonjs": "^28.0.3",
		"@rollup/plugin-node-resolve": "^16.0.1",
		"@rollup/plugin-url": "^6.0.0",
		"@vitejs/plugin-vue": "^5.2.3",
		"@vue/cli-plugin-eslint": "^4.5.4",
		"@vue/cli-service": "^4.5.4",
		"@vue/compiler-sfc": "^3.5.13",
		"@vue/eslint-config-prettier": "^6.0.0",
		"autoprefixer": "^10.2.4",
		"babel-eslint": "10.1.0",
		"eslint": "^7.15.0",
		"eslint-config-airbnb-base": "^14.2.0",
		"eslint-plugin-import": "^2.22.0",
		"eslint-plugin-prettier": "^3.3.1",
		"eslint-plugin-vue": "^7.5.0",
		"lint-staged": "^10.2.11",
		"postcss": "^8.2.4",
		"postcss-import": "^14.0.0",
		"postcss-nested": "^5.0.3",
		"postcss-simple-vars": "^6.0.2",
		"postcss-url": "^10.1.1",
		"precss": "^4.0.0",
		"prettier": "^2.2.1",
		"rimraf": "^3.0.2",
		"rollup": "^2.26.3",
		"rollup-plugin-cleanup": "^3.1.1",
		"rollup-plugin-commonjs": "^10.1.0",
		"rollup-plugin-node-resolve": "^5.2.0",
		"rollup-plugin-postcss": "^4.0.0",
		"rollup-plugin-replace": "^2.2.0",
		"rollup-plugin-terser": "^7.0.2",
		"rollup-plugin-vue": "^6.0.0",
		"sass": "^1.32.5",
		"vite": "^6.3.4",
		"vite-plugin-banner": "^0.8.1",
		"vite-plugin-css-injected-by-js": "^3.5.2",
		"vue": "^3.0.5"
	},
	"dependencies": {
		"fecha": "^4.2.0",
		"lodash-es": "^4.17.21"
	},
	"publishConfig": {
		"access": "public"
	},
	"gitHooks": {
		"pre-commit": "lint-staged"
	},
	"lint-staged": {
		"*.{js,jsx,vue}": [
			"vue-cli-service lint"
		]
	}
}
